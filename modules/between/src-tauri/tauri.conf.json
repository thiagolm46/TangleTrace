{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TangleTrace BETWEEN",
  "version": "0.3.0",
  "identifier": "br.edu.discord-se.annotator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "TangleTrace BETWEEN - Reply-Link Annotation & Review",
      "width": 1440, "height": 940, "minWidth": 640, "minHeight": 520,
      "resizable": true, "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
